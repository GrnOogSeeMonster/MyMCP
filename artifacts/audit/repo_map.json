{
  "services": [
    {
      "name": "mysql",
      "image": "mysql:8.0",
      "ports": ["${DB_PORT}:3306"],
      "env": ["DB_NAME","DB_USER","DB_PASSWORD","DB_ROOT_PASSWORD","DB_PORT"],
      "healthcheck": "mysqladmin ping",
      "depends_on": []
    },
    {
      "name": "migrations",
      "build": "./api",
      "command": "npx prisma generate && npx prisma migrate deploy && npx prisma db seed",
      "env": ["DATABASE_URL"],
      "depends_on": ["mysql:healthy"]
    },
    {
      "name": "api",
      "build": "./api",
      "ports": ["${API_PORT:-8080}:8080"],
      "env": ["DATABASE_URL","NODE_ENV","PORT"],
      "healthcheck": "GET http://localhost:8080/api/health",
      "depends_on": ["migrations:completed_successfully"]
    },
    {
      "name": "ui",
      "build": ".",
      "ports": ["${APP_PORT}:80"],
      "env": ["APP_PORT"],
      "depends_on": ["api:healthy"],
      "notes": "Nginx serving Vite build, proxies /api to api:8080"
    }
  ],
  "entrypoints": {
    "ui": "Nginx on 80 -> static dist",
    "api": "Express on 8080",
    "health": {
      "api": "/api/health"
    }
  },
  "config_sources": ["docker-compose.yml","nginx.conf","api/tsconfig.json","vite.config.ts"],
  "runtime_dependencies": ["MySQL 8.0"],
  "start_commands": [
    "docker compose --env-file .env.local up -d --build"
  ]
}

